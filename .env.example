# Salin menjadi .env lalu isi. Berkas .env TIDAK boleh di-commit.

APP_PORT=3000

# Database lokal (dipakai bila DATABASE_URL kosong)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hunispace
DB_SSLMODE=disable
DB_MAX_CONNS=10

# Opsional: connection string lengkap (mis. Supabase). Bila diisi, DB_* di atas diabaikan.
# Bila memakai pooler mode transaction, tambahkan ?default_query_exec_mode=simple_protocol
DATABASE_URL=

# Autentikasi: JWT_SECRET minimal 32 karakter
JWT_SECRET=
JWT_ISSUER=hunispace
JWT_ACCESS_TTL_MINUTES=60

# Migration otomatis saat server menyala (berkas migrations/*.sql idempotent)
AUTO_MIGRATE=true
# Kosong = pakai migration yang dibenamkan ke binary. Isi path folder untuk membaca dari disk.
MIGRATIONS_DIR=

# Akun owner awal (dibuat sekali bila belum ada). Kosongkan bila tidak perlu.
SEED_OWNER_NAME=Pemilik Kos
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Swagger UI di /swagger/index.html. Bawaan mati; nyalakan hanya saat development.
SWAGGER_ENABLED=false
